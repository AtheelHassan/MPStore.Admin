<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MPStore.Admin.Views.Dashboard"
             Title="لوحة التحكم"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- Header -->
            <Border BackgroundColor="#1e293b"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="90,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="90"
                                HeightRequest="90"
                                BackgroundColor="#334155"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 18">

                            <Grid>
                                <Label Text="🛍️"
                                       FontSize="34"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="White" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="6">
                            <Label Text="لوحة تحكم الإدارة"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label x:Name="WelcomeLabel"
                                   Text="مرحباً بك"
                                   FontSize="14"
                                   TextColor="#cbd5e1" />

                            <Label x:Name="RoleLabel"
                                   Text="جاهز لإدارة النظام"
                                   FontSize="13"
                                   TextColor="#60a5fa" />
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Statistics Row -->
            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="إجمالي المتاجر"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label x:Name="StoresCountLabel"
                               Text="0"
                               TextColor="#60a5fa"
                               FontSize="24"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="إجمالي الأدمن"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label x:Name="AdminsCountLabel"
                               Text="0"
                               TextColor="#34d399"
                               FontSize="24"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="المتاجر النشطة"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label x:Name="ActiveStoresCountLabel"
                               Text="0"
                               TextColor="#fbbf24"
                               FontSize="24"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

                <Border Grid.Column="3"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="الأدمن النشطون"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label x:Name="ActiveAdminsCountLabel"
                               Text="0"
                               TextColor="#a78bfa"
                               FontSize="24"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- Navigation Cards -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding CanViewStores}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStoresTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="المتاجر"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="عرض وإدارة جميع المتاجر"
                               TextColor="#cbd5e1"
                               FontSize="13" />

                        <Label Text="فتح القائمة"
                               TextColor="#60a5fa"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding CanViewAdminUsers}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAdminUsersTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="إدارة الأدمن"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="عرض وإدارة الحسابات الإدارية"
                               TextColor="#cbd5e1"
                               FontSize="13" />

                        <Label Text="فتح القائمة"
                               TextColor="#34d399"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding CanViewAdminRoles}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAdminRolesTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="الأدوار والصلاحيات"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="عرض وإدارة الأدوار الإدارية"
                               TextColor="#cbd5e1"
                               FontSize="13" />

                        <Label Text="فتح القائمة"
                               TextColor="#fbbf24"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="الحساب الحالي"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label x:Name="CurrentUserInfoLabel"
                               Text="-"
                               TextColor="#cbd5e1"
                               FontSize="13" />

                        <Label x:Name="CurrentPermissionsInfoLabel"
                               Text="-"
                               TextColor="#a78bfa"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="White"
                               HorizontalOptions="Center" />

            <Button Text="تسجيل الخروج"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#dc2626"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="14"
                    Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>