<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MPStore.Admin.Views.AdminRolePermissions"
             Title="صلاحيات الدور"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8FA"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Padding="20,18,20,12"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              BackgroundColor="White">

            <Button Text="رجوع"
                    HeightRequest="42"
                    Padding="14,0"
                    CornerRadius="12"
                    BackgroundColor="#E5E7EB"
                    TextColor="#111827"
                    Clicked="OnBackClicked" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4">
                <Label Text="صلاحيات الدور"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#111827" />

                <Label x:Name="RoleNameLabel"
                       Text="إدارة صلاحيات الدور الإداري"
                       FontSize="14"
                       TextColor="#6B7280" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              Padding="16,12,16,12">

            <CollectionView x:Name="PermissionsCollectionView"
                            SelectionMode="None"
                            ItemsLayout="VerticalList"
                            Margin="0,0,0,8">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="لا توجد صلاحيات لعرضها"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#374151"
                               HorizontalTextAlignment="Center" />
                        <Label Text="سيتم إظهار الصلاحيات هنا بعد التحميل"
                               FontSize="14"
                               TextColor="#6B7280"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="14"
                                Margin="0,0,0,12"
                                StrokeShape="RoundRectangle 16">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding PermissionCode}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111827" />

                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="#6B7280" />
                                </VerticalStackLayout>

                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsAllowed}"
                                        VerticalOptions="Center" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#2563EB"
                               WidthRequest="50"
                               HeightRequest="50"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <Label x:Name="MessageLabel"
                   IsVisible="False"
                   TextColor="#DC2626"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="End"
                   Margin="20,0,20,10" />
        </Grid>

        <Grid Grid.Row="2"
              Padding="16,8,16,18"
              BackgroundColor="#F7F8FA">
            <Button Text="حفظ الصلاحيات"
                    HeightRequest="50"
                    CornerRadius="14"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnSaveClicked" />
        </Grid>

    </Grid>
</ContentPage>