<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MPStore.Admin.Views.Login"
             Title="تسجيل دخول الأدمن"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20"
                             VerticalOptions="Center">

            <Border BackgroundColor="#1e293b"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="90,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="90"
                                HeightRequest="90"
                                BackgroundColor="#334155"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 18">

                            <Grid>
                                <Label Text="🔐"
                                       FontSize="34"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="White" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="6">
                            <Label Text="الادارة"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="تسجيل دخول الإدارة الرئيسية"
                                   FontSize="14"
                                   TextColor="#cbd5e1" />

                            <Label Text="أدخل بياناتك للوصول إلى لوحة التحكم"
                                   FontSize="13"
                                   TextColor="#60a5fa" />
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1e293b"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="16">

                    <Label Text="اسم المستخدم"
                           FontSize="14"
                           TextColor="White" />

                    <Border BackgroundColor="#334155"
                            StrokeThickness="0"
                            Padding="12,4"
                            StrokeShape="RoundRectangle 14">

                        <Entry x:Name="UserNameEntry"
                               Placeholder="أدخل اسم المستخدم"
                               Keyboard="Text"
                               HeightRequest="50"
                               BackgroundColor="Transparent"
                               TextColor="White"
                               PlaceholderColor="#94a3b8" />
                    </Border>

                    <Label Text="كلمة المرور"
                           FontSize="14"
                           TextColor="White" />

                    <Border BackgroundColor="#334155"
                            StrokeThickness="0"
                            Padding="12,4"
                            StrokeShape="RoundRectangle 14">

                        <Entry x:Name="PasswordEntry"
                               Placeholder="أدخل كلمة المرور"
                               IsPassword="True"
                               HeightRequest="50"
                               BackgroundColor="Transparent"
                               TextColor="White"
                               PlaceholderColor="#94a3b8" />
                    </Border>

                    <Button x:Name="LoginButton"
                            Text="تسجيل الدخول"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            Clicked="OnLoginClicked" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="White"
                                       HorizontalOptions="Center" />

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           MaxLines="8"
                           HorizontalTextAlignment="Center"
                           TextColor="#fca5a5"
                           IsVisible="False" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>