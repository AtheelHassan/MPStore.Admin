<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MPStore.Admin.Views.StoresList"
             Title="المتاجر"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0f172a"
             FlowDirection="RightToLeft">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <Border BackgroundColor="#1e293b"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="90,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="90"
                                HeightRequest="90"
                                BackgroundColor="#334155"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 18">

                            <Grid>
                                <Label Text="🏬"
                                       FontSize="34"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="White" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="6">
                            <Label Text="إدارة المتاجر"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="عرض جميع المتاجر وإدارتها"
                                   FontSize="14"
                                   TextColor="#cbd5e1" />

                            <Label Text="يمكنك البحث والتصفية حسب الاسم والنوع والحالة"
                                   FontSize="13"
                                   TextColor="#60a5fa" />
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="14">

                <Button Grid.Column="0"
                        Text="لوحة التحكم"
                        HeightRequest="48"
                        CornerRadius="14"
                        BackgroundColor="#334155"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnBackClicked" />

                <Button Grid.Column="1"
                        Text="إضافة متجر"
                        HeightRequest="48"
                        CornerRadius="14"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        IsVisible="{Binding CanCreateStore}"
                        Clicked="OnAddStoreClicked" />
            </Grid>

            <Border BackgroundColor="#1e293b"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="قائمة المتاجر"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="جميع المتاجر المتاحة في النظام"
                                   FontSize="13"
                                   TextColor="#cbd5e1" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="تحديث"
                                HeightRequest="42"
                                Padding="16,0"
                                CornerRadius="12"
                                BackgroundColor="#475569"
                                TextColor="White"
                                FontAttributes="Bold"
                                Clicked="OnRefreshClicked" />
                    </Grid>

                    <Entry x:Name="SearchEntry"
                           Placeholder="ابحث بالاسم أو رابط المتجر أو الوصف أو نوع المتجر"
                           HeightRequest="50"
                           BackgroundColor="#334155"
                           TextColor="White"
                           PlaceholderColor="#94a3b8"
                           TextChanged="OnSearchTextChanged" />

                    <Border BackgroundColor="#334155"
                            StrokeThickness="0"
                            Padding="12"
                            StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="البحث والفلاتر"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="FiltersSummaryLabel"
                                           Text="الفلاتر مخفية"
                                           FontSize="12"
                                           TextColor="#cbd5e1" />
                                </VerticalStackLayout>

                                <Button x:Name="ToggleFiltersButton"
                                        Grid.Column="1"
                                        Text="إظهار ▼"
                                        HeightRequest="40"
                                        Padding="14,0"
                                        CornerRadius="12"
                                        BackgroundColor="#475569"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        Clicked="OnToggleFiltersClicked" />
                            </Grid>

                            <VerticalStackLayout x:Name="FiltersPanel"
                                                 IsVisible="False"
                                                 Spacing="12">

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">

                                    <Border BackgroundColor="#1e293b"
                                            StrokeThickness="0"
                                            Padding="12,8"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="نوع المتجر"
                                                   FontSize="13"
                                                   TextColor="#cbd5e1" />
                                            <Picker x:Name="StoreTypeFilterPicker"
                                                    Title="اختر النوع"
                                                    ItemDisplayBinding="{Binding Name}"
                                                    HeightRequest="50"
                                                    BackgroundColor="#1e293b"
                                                    TitleColor="#94a3b8"
                                                    TextColor="White"
                                                    SelectedIndexChanged="OnFilterChanged" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#1e293b"
                                            StrokeThickness="0"
                                            Padding="12,8"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="الحالة"
                                                   FontSize="13"
                                                   TextColor="#cbd5e1" />
                                            <Picker x:Name="StatusFilterPicker"
                                                    Title="اختر الحالة"
                                                    HeightRequest="50"
                                                    BackgroundColor="#1e293b"
                                                    TitleColor="#94a3b8"
                                                    TextColor="White"
                                                    SelectedIndexChanged="OnFilterChanged" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">

                                    <Border BackgroundColor="#1e293b"
                                            StrokeThickness="0"
                                            Padding="12,8"
                                            StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="ترتيب النتائج"
                                                   FontSize="13"
                                                   TextColor="#cbd5e1" />
                                            <Picker x:Name="SortPicker"
                                                    Title="اختر الترتيب"
                                                    HeightRequest="50"
                                                    BackgroundColor="#1e293b"
                                                    TitleColor="#94a3b8"
                                                    TextColor="White"
                                                    SelectedIndexChanged="OnFilterChanged" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Button Grid.Column="1"
                                            Text="مسح"
                                            HeightRequest="50"
                                            WidthRequest="100"
                                            CornerRadius="14"
                                            BackgroundColor="#475569"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            Clicked="OnClearFiltersClicked" />
                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="StoresCollectionView"
                            SelectionMode="None"
                            ItemsLayout="VerticalList"
                            Margin="0,0,0,8">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="لا توجد متاجر لعرضها"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="جرّب تغيير البحث أو الفلاتر أو أضف متجرًا جديدًا"
                               FontSize="14"
                               TextColor="#cbd5e1"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border StrokeThickness="0"
                                BackgroundColor="#1e293b"
                                Padding="16"
                                Margin="0,0,0,12"
                                StrokeShape="RoundRectangle 20">

                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="72,*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="10">

                                <Border Grid.RowSpan="2"
                                        Grid.Column="0"
                                        WidthRequest="72"
                                        HeightRequest="72"
                                        Padding="6"
                                        BackgroundColor="#334155"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        VerticalOptions="Start">

                                    <Image Source="{Binding LogoPath}"
                                           Aspect="AspectFit" />

                                </Border>

                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="1"
                                                     Spacing="4">

                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White" />

                                    <Label Text="{Binding Slug}"
                                           FontSize="13"
                                           TextColor="#cbd5e1" />

                                    <Label Text="{Binding StoreTypeName}"
                                           FontSize="12"
                                           TextColor="#93c5fd" />

                                </VerticalStackLayout>

                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        Padding="10,6"
                                        BackgroundColor="#E5F7EB"
                                        StrokeThickness="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        StrokeShape="RoundRectangle 12">

                                    <Label Text="{Binding IsActiveText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#15803D" />

                                </Border>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="2"
                                                     Spacing="6">

                                    <Label Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#e2e8f0"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <Label Text="{Binding StoreTypeCode}"
                                           FontSize="13"
                                           TextColor="#cbd5e1" />

                                </VerticalStackLayout>

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10">

                                    <Label Text="{Binding CreatedAtText}"
                                           FontSize="12"
                                           TextColor="#94a3b8"
                                           VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="حذف"
                                            HeightRequest="40"
                                            Padding="14,0"
                                            CornerRadius="12"
                                            BackgroundColor="#7f1d1d"
                                            TextColor="White"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanDeleteStore}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="2"
                                            Text="تعديل"
                                            HeightRequest="40"
                                            Padding="14,0"
                                            CornerRadius="12"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanUpdateStore}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="White"
                               WidthRequest="50"
                               HeightRequest="50"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <Label x:Name="MessageLabel"
                   IsVisible="False"
                   TextColor="#fca5a5"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   Margin="20,0,20,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>